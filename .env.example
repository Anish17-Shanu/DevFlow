# DevFlow environment template. Copy to .env for local development.
# Production deployments must inject secrets from a secrets manager, not a file.

# --- Core ---
DEVFLOW_ENVIRONMENT=development
DEVFLOW_APP_VERSION=2.0.0
DEVFLOW_DATABASE_URL=sqlite+aiosqlite:///./devflow.db
# Postgres example:
# DEVFLOW_DATABASE_URL=postgresql+asyncpg://devflow:change-me@127.0.0.1:5432/devflow
DEVFLOW_DATABASE_POOL_SIZE=10
DEVFLOW_DATABASE_MAX_OVERFLOW=10
DEVFLOW_DATABASE_POOL_TIMEOUT_SECONDS=30
DEVFLOW_AUTO_MIGRATE=true
DEVFLOW_DOCS_ENABLED=true

# --- Auth and tenancy ---
DEVFLOW_BOOTSTRAP_API_KEY=devflow-dev-key
DEVFLOW_BOOTSTRAP_TENANT_NAME=Default tenant
DEVFLOW_AUTH_CACHE_TTL_SECONDS=30
DEVFLOW_RATE_LIMIT_REQUESTS_PER_MINUTE=600
DEVFLOW_RATE_LIMIT_BURST=100
DEVFLOW_RATE_LIMIT_BACKEND=memory
DEVFLOW_MAX_CONCURRENT_EXECUTIONS_PER_TENANT=20
# 32-byte urlsafe-base64 Fernet key; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVFLOW_SECRET_ENCRYPTION_KEY=

# --- CORS ---
DEVFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Workers and queue ---
DEVFLOW_INLINE_WORKERS_ENABLED=true
DEVFLOW_WORKER_COUNT=4
DEVFLOW_WORKER_POLL_INTERVAL_MS=250
DEVFLOW_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
DEVFLOW_WORKER_SHUTDOWN_GRACE_SECONDS=20
DEVFLOW_WORKER_INSTANCE_ID=
DEVFLOW_QUEUE_LEASE_SECONDS=30
DEVFLOW_QUEUE_POISON_MAX_ATTEMPTS=5
DEVFLOW_QUEUE_AGING_SECONDS=60
DEVFLOW_MAX_CONCURRENT_TASKS_PER_WORKFLOW=16
DEVFLOW_MAX_TASK_TIMEOUT_SECONDS=600
DEVFLOW_QUEUE_NAME=database

# --- API hardening ---
DEVFLOW_MAX_REQUEST_BODY_BYTES=1048576
DEVFLOW_REQUEST_TIMEOUT_SECONDS=30
DEVFLOW_ALLOW_PRIVATE_TASK_TARGETS=false

# --- Observability ---
DEVFLOW_LOG_LEVEL=INFO
DEVFLOW_LOG_FORMAT=json
DEVFLOW_METRICS_ENABLED=true
DEVFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=
# Cross-replica websocket fan-out over Postgres LISTEN/NOTIFY: auto (default), postgres, off.
DEVFLOW_REALTIME_BUS=auto
DEVFLOW_REALTIME_CHANNEL=devflow_events

# --- Background services ---
DEVFLOW_WATCHDOG_INTERVAL_SECONDS=15
DEVFLOW_SCHEDULER_INTERVAL_SECONDS=15
DEVFLOW_RETENTION_INTERVAL_SECONDS=3600
DEVFLOW_LOG_RETENTION_DAYS=30
DEVFLOW_EXECUTION_RETENTION_DAYS=90
DEVFLOW_TASK_RETENTION_DAYS=30
DEVFLOW_QUEUE_RETENTION_DAYS=7
DEVFLOW_WORKER_RETENTION_DAYS=7

# --- Webhooks ---
DEVFLOW_WEBHOOK_TIMEOUT_SECONDS=10
DEVFLOW_WEBHOOK_MAX_ATTEMPTS=5

# --- Docker Compose (production profile) ---
# docker-compose.yml also requires DEVFLOW_BOOTSTRAP_API_KEY (unique, 24+ chars),
# DEVFLOW_SECRET_ENCRYPTION_KEY (Fernet key) and POSTGRES_PASSWORD. Generate strong,
# unique values and never commit the resulting .env file.
POSTGRES_PASSWORD=
